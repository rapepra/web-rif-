---
import Logo from './Logo.astro';
import { negocio, grupos, zona } from '../data/negocio';
interface Props { variant?: 'full' | 'landing' }
const { variant = 'full' } = Astro.props;
const conPagina = grupos.flatMap((g) => g.servicios).filter((s) => s.url);
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <Logo />
        <p style="margin-top:16px">Fontanería, gas, calefacción, reformas y desatascos en Ermua y alrededores. Más de 20 años de oficio.</p>
        <address>
          <strong style="color:#fff">{negocio.nombre}</strong><br />
          {negocio.direccion.calle}<br />
          {negocio.direccion.cp} {negocio.direccion.localidad}, {negocio.direccion.provincia}<br />
          Móvil: <a href={`tel:${negocio.telefono.e164}`} data-ub="pie">{negocio.telefono.display}</a><br />
          Fijo: <a href={`tel:${negocio.fijo.e164}`} data-ub="pie">{negocio.fijo.display}</a><br />
          <a href={`mailto:${negocio.email}`}>{negocio.email}</a>
        </address>
      </div>
      <div>
        <h2>Horario</h2>
        <p>Lunes a viernes<br />9:00–13:00 y 15:00–19:00</p>
        <p>Sábado y domingo<br />Cerrado</p>
      </div>
      {variant === 'full' ? (
        <>
          <div>
            <h2>Servicios</h2>
            <ul>{conPagina.map((s) => <li><a href={s.url} data-pendiente={s.lista ? undefined : ''}>{s.enlace}</a></li>)}</ul>
          </div>
          <div>
            <h2>Zona</h2>
            <ul>
              {zona.map((z) => z.slug
                ? <li><a href={`/${z.slug}/`} data-pendiente>Fontanero en {z.nombre}</a></li>
                : <li><a href="/">Fontanero en {z.nombre}</a></li>)}
            </ul>
          </div>
        </>
      ) : (
        <div>
          <h2>Más servicios</h2>
          <ul><li><a href="/">Todos los servicios de Fontanería RIF</a></li><li><a href="/contacto/">Contacto</a></li></ul>
        </div>
      )}
    </div>
    <div class="ftr__bottom">
      <span>© {year} {negocio.nombre}. Todos los derechos reservados.</span>
      <nav aria-label="Legal">
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/privacidad/">Privacidad y cookies</a>
        <button type="button" class="linkbtn" data-cookie-open>Configurar cookies</button>
      </nav>
    </div>
  </div>
</footer>
