---
// «Fachada» de Google Maps: SVG ligero y el iframe solo se carga al hacer clic (0 KB de Google hasta entonces).
import Icon from './Icon.astro';
import { negocio } from '../data/negocio';
---
<div>
  <div class="map" data-map={negocio.mapsEmbed}>
    <svg viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect width="600" height="450" fill="#E6EDF5"/>
      <path d="M-20 300C80 280 140 330 240 300S420 210 620 240" stroke="#B9D4F6" stroke-width="22" fill="none"/>
      <g stroke="#fff" stroke-width="14" fill="none" stroke-linecap="round">
        <path d="M0 120h600M0 380h600M110 0v450M420 0v450M0 30l600 220M260 0l-60 450"/>
      </g>
      <g stroke="#fff" stroke-width="6" fill="none"><path d="M0 200h600M330 0v450M520 0v450M40 0v450M0 60h600"/></g>
      <g fill="#D3DEEA"><rect x="130" y="140" width="60" height="44" rx="4"/><rect x="345" y="140" width="60" height="44" rx="4"/><rect x="440" y="80" width="66" height="30" rx="4"/><rect x="60" y="220" width="40" height="60" rx="4"/><rect x="440" y="300" width="64" height="60" rx="4"/></g>
      <circle cx="300" cy="190" r="46" fill="#1D63C7" opacity=".15"/>
      <path d="M300 125c-22 0-38 16-38 37 0 28 38 64 38 64s38-36 38-64c0-21-16-37-38-37Z" fill="#0A1F3D"/>
      <circle cx="300" cy="162" r="13" fill="#FFB020"/>
    </svg>
    <div class="map__ui">
      <address><strong>{negocio.nombre}</strong><br />{negocio.direccionTexto}</address>
      <button type="button" class="btn" data-map-load><Icon name="pin" size={18} />Ver mapa</button>
    </div>
  </div>
  <p class="map__note">Al cargar el mapa, Google puede usar cookies. También puedes <a href={negocio.mapsUrl} target="_blank" rel="noopener">abrir la ubicación en Google Maps</a>.</p>
</div>
