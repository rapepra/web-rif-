---
import type { Miga } from '../lib/schema';
interface Props { migas: Miga[] }
const { migas } = Astro.props;
---
<nav class="crumbs" aria-label="Migas de pan">
  <ol>
    {migas.map((m, i) =>
      i < migas.length - 1
        ? <li><a href={m.path}>{m.nombre}</a></li>
        : <li><span aria-current="page">{m.nombre}</span></li>
    )}
  </ol>
</nav>
