---
import { iconos } from '../data/iconos';
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
---
<svg class:list={['ico', cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={iconos[name]} />
