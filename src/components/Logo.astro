---
interface Props { href?: string }
const { href = '/' } = Astro.props;
---
<a class="logo" href={href}>
  <span class="logo__mark" aria-hidden="true">
    <svg width="20" height="24" viewBox="0 0 20 24"><path d="M10 1C8 6 2 10 2 15.5A8 8 0 0 0 18 15.5C18 10 12 6 10 1Z" fill="#FFB020"/><path d="M6.5 16a3.5 3.5 0 0 0 3.5 3.5" stroke="#0A1F3D" stroke-width="2" stroke-linecap="round" fill="none"/></svg>
  </span>
  <span>Fontanería <b>RIF</b><small>Ermua · Bizkaia</small></span>
</a>
