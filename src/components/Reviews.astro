---
// Solo las reseñas reales. No se muestran estrellas porque no tenemos la puntuación: [CONFIRMAR].
import Icon from './Icon.astro';
import { resenas } from '../data/negocio';
interface Props { solo?: string[] }
const { solo } = Astro.props;
const lista = solo ? resenas.filter((r) => solo.includes(r.autor)) : resenas;
const iniciales = (n: string) => (n.split(' ').filter((p) => !/^(SL|SA|SLU)$/.test(p)).length > 1 ? n.split(' ').map((p) => p[0]).slice(0, 2).join('') : n.slice(0, 2).toUpperCase());
---
<div class="reviews" style={lista.length === 1 ? 'grid-template-columns:1fr;max-width:640px' : undefined}>
  {lista.map((r) => (
    <figure class="rev">
      <Icon name="quote" size={34} />
      <ul class="rev__tags" aria-label="Lo que destaca">{r.destaca.map((d) => <li>{d}</li>)}</ul>
      <blockquote>
        <p>{r.resumen}</p>
        <span class="tbd">[PEGAR TEXTO LITERAL DE LA RESEÑA]</span>
      </blockquote>
      <footer>
        <span class="rev__av" aria-hidden="true">{iniciales(r.autor)}</span>
        <div><cite>{r.autor}</cite><small>{r.tipo} · <span class="tbd">[PLATAFORMA Y NOTA]</span></small></div>
      </footer>
    </figure>
  ))}
</div>
