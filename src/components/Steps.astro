---
interface Props { pasos?: { t: string; d: string }[] }
const { pasos = [
  { t: 'Nos llamas o escribes', d: 'Cuéntanos qué pasa. Si nos mandas una foto por WhatsApp, llegamos con una idea más clara.' },
  { t: 'Vamos y te damos precio', d: 'Revisamos el problema en tu casa o en tu comunidad y te damos un presupuesto sin compromiso.' },
  { t: 'Lo resolvemos', d: 'Hacemos el trabajo con nuestro propio equipo y te explicamos qué hemos hecho y por qué.' },
] } = Astro.props;
---
<ol class="steps" style="list-style:none;padding:0;margin:0">
  {pasos.map((p) => <li class="step"><h3>{p.t}</h3><p>{p.d}</p></li>)}
</ol>
