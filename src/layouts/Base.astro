---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Scripts from '../components/Scripts.astro';
import { SITE, negocio, EU_LISTO } from '../data/negocio';

interface Props {
  title: string;          // < 60 caracteres: keyword + localidad + marca
  description: string;    // < 155 caracteres, con CTA
  path: string;           // ruta canónica, p. ej. '/desatascos-ermua/'
  variant?: 'full' | 'landing';
  lang?: 'es' | 'eu';
  esPath?: string | null; // alternativa en castellano
  euPath?: string | null; // alternativa en euskera (null = aún no existe)
  schema?: object;
  noindex?: boolean;
  quoteHref?: string;     // destino del botón «Presupuesto» de la barra móvil
}
const {
  title, description, path, variant = 'full', lang = 'es',
  esPath = lang === 'es' ? path : '/', euPath = null, schema, noindex = false, quoteHref = '#contacto',
} = Astro.props;

const canonical = SITE + path;
const og = `${SITE}/og-fontaneria-rif.jpg`;
const conEu = EU_LISTO && euPath;
if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[SEO] title > 60 (${title.length}): ${title}`);
  if (description.length > 155) console.warn(`[SEO] description > 155 (${description.length}): ${path}`);
}
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {path !== '/404/' && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  {esPath && <link rel="alternate" hreflang="es-ES" href={SITE + esPath} />}
  {conEu && <link rel="alternate" hreflang="eu-ES" href={SITE + euPath} />}
  {esPath && <link rel="alternate" hreflang="x-default" href={SITE + esPath} />}
  <meta name="theme-color" content="#061430" />
  <meta name="format-detection" content="telephone=no" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={negocio.nombre} />
  <meta property="og:locale" content={lang === 'eu' ? 'eu_ES' : 'es_ES'} />
  {conEu && <meta property="og:locale:alternate" content={lang === 'eu' ? 'es_ES' : 'eu_ES'} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Fontanería RIF, fontaneros en Ermua" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Header variant={variant} lang={lang} esPath={esPath ?? '/'} euPath={euPath} />
  <main id="contenido">
    <slot />
  </main>
  <Footer variant={variant} />
  <MobileBar quoteHref={quoteHref} labels={lang === 'eu' ? ['Deitu', 'WhatsApp', 'Aurrekontua'] : undefined} />
  <CookieBanner />
  <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  <Scripts />
</body>
</html>
