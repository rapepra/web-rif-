    {
      "@type": "FAQPage",
      "@id": "https://fontaneriarif.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta un desatasco en Ermua?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Depende de dónde esté el atasco (no es lo mismo un fregadero que una arqueta) y de si hace falta la cámara para localizarlo. Antes de empezar te decimos el precio, y el presupuesto es sin compromiso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atendéis urgencias en fin de semana?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nuestro horario es de lunes a viernes, de 9:00 a 13:00 y de 15:00 a 19:00; sábados y domingos está cerrado. Fuera de horario puedes mandarnos un WhatsApp al 605 711 081 con fotos de la avería y te contestamos al abrir."
          }
        },
        {
          "@type": "Question",
          "name": "¿Merece la pena la aerotermia en Bizkaia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "En muchas casas, sí. La aerotermia saca hasta un 80 % de su energía del aire, y los inviernos suaves de Bizkaia le favorecen. Que compense depende del aislamiento, de si tienes suelo radiante o radiadores y de lo que gastas ahora en calefacción. Lo estudiamos en tu vivienda y te damos presupuesto sin compromiso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Gestionáis los permisos de gas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Somos instaladores autorizados de calderas, así que al terminar te entregamos la documentación que pide la normativa para poner la instalación en marcha."
          }
        },
        {
          "@type": "Question",
          "name": "¿Trabajáis con comunidades de vecinos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Trabajamos con comunidades de propietarios en bajantes, arquetas, desatascos, canalones, impermeabilización de terrazas, tejados, chimeneas y sistemas anti-aves. También con hoteles, colegios, oficinas y hospitales."
          }
        },
        {
          "@type": "Question",
          "name": "¿Hacéis la reforma del baño completa o solo la fontanería?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Completa. Tenemos fontaneros, albañiles, electricistas y pintores, así que no tienes que buscar ni coordinar a nadie más. También adaptamos baños para movilidad reducida y cambiamos bañeras por platos de ducha."
          }
        },
        {
          "@type": "Question",
          "name": "¿En qué localidades trabajáis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Estamos en Ermua y trabajamos en Ermua y alrededores: Eibar, Mallabia, Zaldibar, Elgeta, Berriz, Durango y Elorrio."
          }
        }
      ]
    }
